VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
VITE_APP_URL=http://localhost:5173
VITE_ENABLE_REPORTS=false
# Optional first-party collector. Payloads contain event metadata, not form data or tokens.
VITE_TELEMETRY_ENDPOINT=
VITE_TURNSTILE_SITE_KEY=

# Edge Function secrets (set with `supabase secrets set`; never prefix with VITE_).
PUBLIC_APP_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
RESEND_API_KEY=
RESEND_FROM=DroneSMS <operations@example.com>
STORAGE_CLEANUP_SECRET=
